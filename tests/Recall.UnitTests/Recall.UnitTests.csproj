<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <!-- The OpenAPI generator intercepts each AddOpenApi call. The targets of the Microsoft.AspNetCore.OpenApi package enable this, and they do not flow through the Server project reference. -->
        <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="Aspire.Hosting.Testing" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Mono.Cecil" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Recall.AppHost\Recall.AppHost.csproj" />
        <ProjectReference Include="..\..\Recall.Server\Recall.Server.csproj" />
        <ProjectReference Include="..\..\Recall.SourceGenerators\Recall.SourceGenerators.csproj" />
        <ProjectReference Include="..\Recall.ArchitectureFixtures\Recall.ArchitectureFixtures.csproj" />
        <ProjectReference Include="..\Recall.SharedTestHelpers\Recall.SharedTestHelpers.csproj" />
    </ItemGroup>

    <!-- BannedSymbols.txt bans a today that comes from the UTC date or the clock of the machine -->
    <ItemGroup>
        <AdditionalFiles Include="..\BannedSymbols.txt" />
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Recall.Transcriber\ChunkCutter.cs" Link="Domain\Recordings\ChunkCutter.cs" />
  </ItemGroup>

</Project>
