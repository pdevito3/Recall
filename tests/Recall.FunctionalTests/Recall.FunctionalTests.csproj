<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <OutputType>Exe</OutputType>
        <!-- CS1573 asks for a param tag on each parameter once one parameter has a tag. A test record documents only
             the parameters whose name does not tell their meaning. -->
        <NoWarn>$(NoWarn);CS1573</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
        <PackageReference Include="TUnit" />
        <PackageReference Include="Shouldly" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
        <PackageReference Include="WebMotions.Fake.Authentication.JwtBearer" />
        <PackageReference Include="OpenTelemetry.Exporter.InMemory" />
        <PackageReference Include="ModelContextProtocol.Core" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Recall.Server\Recall.Server.csproj" />
        <ProjectReference Include="..\Recall.SharedTestHelpers\Recall.SharedTestHelpers.csproj" />
    </ItemGroup>

    <!-- BannedSymbols.txt bans a today that comes from the UTC date or the clock of the machine -->
    <ItemGroup>
        <AdditionalFiles Include="..\BannedSymbols.txt" />
        <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>
