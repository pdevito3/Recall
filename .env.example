# Copy this file to .env, and edit the values. docs/install.md explains each one.

# Your login provider. With no provider, Recall starts and its login page says what to set.
Auth__Providers__0__Id=keycloak
Auth__Providers__0__DisplayName=Keycloak
Auth__Providers__0__Issuer=https://keycloak.example.com/realms/home
Auth__Providers__0__ClientId=recall
Auth__Providers__0__ClientSecret=change-me
# Remove the first # only for an issuer on http.
#Auth__Providers__0__AllowHttp=true

# After the first login, this lets another person of your provider make an account.
#Auth__OpenSignup=true

# The names of this server. A request with another Host header gets a 400.
#AllowedHosts=recall.example.com

# The port of this machine for plain HTTP.
#RECALL_PORT=8080

# A folder of this machine in place of the Docker volume, and the user and group that own the folder.
#RECALL_DATA=/volume1/docker/recall
#PUID=1026
#PGID=100

# The address of Recall with HTTPS, and other ports for Caddy, for compose.tls.yaml.
#RECALL_TLS_ORIGIN=https://recall.example.com
#RECALL_TLS_PORT=443
#RECALL_TLS_HTTP_PORT=80

# The version of a published image.
#RECALL_TAG=latest

# The time between two health probes.
#RECALL_PROBE_INTERVAL=1h
