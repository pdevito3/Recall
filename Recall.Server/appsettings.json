{
  "ConnectionStrings": {
    "appdb": "Data Source=/data/recall.db"
  },
  "FileStore": {
    "Root": "/data/files"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        // A Degraded check logs a warning at each probe, and the file store logs its one error when the state changes
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Error",
        "System": "Warning",
        "ZiggyCreatures.Caching.Fusion": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          // An object, not a string, so that appsettings.Development.json can replace the type
          "formatter": {
            "type": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Recall.Server",
      "Environment": "Production"
    }
  },
  // The files beside the database. Each signal keeps at most FileSizeBytes times FilesKept, so these limits together
  // hold at most 450 MiB. A file can pass its size by one line. A file also goes when it is older than DaysKept.
  "FileTelemetry": {
    "Logs": { "FileSizeBytes": 10485760, "FilesKept": 20, "DaysKept": 14 },
    "Traces": { "FileSizeBytes": 10485760, "FilesKept": 20, "DaysKept": 14 },
    "Metrics": { "FileSizeBytes": 10485760, "FilesKept": 5, "DaysKept": 14 },
    "MetricExportSeconds": 60
  },
  "AllowedHosts": "*",
  "Kestrel": {
    // In development, Aspire reads these named endpoints and replaces each Url.
    "Endpoints": {
      "http": { "Url": "http://+:8080" }
    }
  },
  "Tenancy": {
    // The client IDs of the machine clients that can read the rows of all tenants, with no right to change them
    "ReadAllTenantsClientIds": [],
    // The client IDs of the machine clients that can add tenants and manage any tenant. They also read all rows.
    "ManageAllTenantsClientIds": []
  }
}
